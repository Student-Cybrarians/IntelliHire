{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intellihire",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intellihire-db",
      "database_id": "63fdd68c-ff53-4aea-8327-2336b5e77587"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "ce6547d827444f33b262781d9fecbb33"
    }
  ]
}
