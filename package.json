{
  "name": "intellihire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "wrangler": "wrangler",
    "deploy": "npm run preflight && wrangler pages deploy dist --project-name intellihire-v3",
    "test": "vitest run",
    "preflight": "node scripts/preflight.mjs",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:a11y": "vitest run tests/a11y.test.ts",
    "test:ai": "vitest run tests/ai.test.ts"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "hono": "^4.13.10",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.9",
    "wrangler": "^4.145.0"
  }
}
