# IntelliHire Environment Variables
# Copy this file to .env or .dev.vars for local development.
# NEVER commit real API keys or secrets to source control.

# Application Environment
ENVIRONMENT=development

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# NVIDIA AI & NIM Integration
# Obtain an API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TTS_URL=https://integrate.api.nvidia.com/v1/audio/speech
NVIDIA_DEFAULT_MODEL=meta/muse-glimmer-30b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_GUARDRAIL_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# Cloudflare D1 & KV (Configured automatically in wrangler.jsonc for Cloudflare Pages)
# DB=intellihire-db
# SESSION_KV=ce6547d827444f33b262781d9fecbb33
# RESUME_KV=88a7fca49a7f4baab3a5de663935a5d3
